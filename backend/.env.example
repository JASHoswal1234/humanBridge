# Sandbox test credentials from developer.paypal.com — never commit secrets.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Needed for real document extraction. Without a key, use clearly labeled Demo Batch.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
